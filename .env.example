# 环境变量模板：复制为 .env.local 后按需覆盖（.env.local 已被 .gitignore 忽略）

# 是否启用 MSW mock 数据
#   true  —— 前端完全离线可用，不依赖任何后端（默认，用于演示与开发）
#   false —— 请求真实接口，需要同时配置 VITE_API_BASE / VITE_PROXY_TARGET
VITE_USE_MOCK=true

# 接口前缀：/api 表示同域（开发环境走 Vite proxy）
VITE_API_BASE=/api

# 开发环境代理目标，仅 VITE_USE_MOCK=false 时生效
VITE_PROXY_TARGET=https://pcapi-xiaotuxian-front-devtest.itheima.net

# 方案 B 落地后大致长这样（届时 mock 关闭）：
# VITE_USE_MOCK=false
# VITE_API_BASE=https://api.your-domain.com
