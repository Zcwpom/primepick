{
  "name": "primepick",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "size": "node scripts/size-report.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-mock.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/record-demo.mjs --gif docs/demo.gif",
    "fixtures:capture": "node scripts/capture-fixtures.mjs",
    "fixtures:summary": "node scripts/fixture-summary.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.2",
    "element-plus": "^2.13.7",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "~1.86.0",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "npm-run-all2": "^8.0.4",
    "sass": "^1.99.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
